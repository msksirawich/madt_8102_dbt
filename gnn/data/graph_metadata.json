  "usage_example": {
    "pytorch_geometric": {
      "installation": "pip install torch-geometric",
      "code_snippet": "import pandas as pd\nimport torch\nfrom torch_geometric.data import HeteroData\n\n# Load graph\ndata = HeteroData()\n\n# Load user nodes\nusers = pd.read_csv('nodes_user.csv')\ndata['user'].x = torch.tensor(users[feature_cols].values, dtype=torch.float)\n\n# Load job nodes\njobs = pd.read_csv('nodes_job.csv')\ndata['job'].x = torch.tensor(jobs[feature_cols].values, dtype=torch.float)\n\n# Load edges\nuser_skill_edges = pd.read_csv('edges_user_skill.csv')\ndata['user', 'has_skill', 'skill'].edge_index = torch.tensor(\n    [user_skill_edges['src_node_id'].values,\n     user_skill_edges['dst_node_id'].values],\n    dtype=torch.long\n)"
    },
    "dgl": {
      "installation": "pip install dgl",
      "code_snippet": "import pandas as pd\nimport dgl\nimport torch\n\n# Load edges\nuser_skill = pd.read_csv('edges_user_skill.csv')\njob_skill = pd.read_csv('edges_job_skill.csv')\nuser_job = pd.read_csv('edges_user_job.csv')\n\n# Create heterograph\ngraph_data = {\n    ('user', 'has_skill', 'skill'): (user_skill['src_node_id'], user_skill['dst_node_id']),\n    ('job', 'requires_skill', 'skill'): (job_skill['src_node_id'], job_skill['dst_node_id']),\n    ('user', 'interacts', 'job'): (user_job['src_node_id'], user_job['dst_node_id'])\n}\n\ng = dgl.heterograph(graph_data)\n\n# Add node features\nusers = pd.read_csv('nodes_user.csv')\ng.nodes['user'].data['feat'] = torch.tensor(users[feature_cols].values)"
    }
  }
